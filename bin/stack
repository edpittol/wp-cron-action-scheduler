#!/usr/bin/env bash
#
# Lifecycle wrapper around docker compose for this PoC's WordPress +
# Action Scheduler stack.
#
# Namespacing: the project name and host port are derived from a hash of
# this checkout's absolute path, so two checkouts (e.g. two worktrees, or
# two clones) can run `bin/stack up` at the same time without colliding on
# container/network/volume names or on the published port.
#
# Usage:
#   bin/stack up               # build (if needed) and start, print the URL
#   bin/stack down [args...]   # stop and remove containers
#   bin/stack shell            # interactive shell in the wordpress container
#   bin/stack exec <cmd>       # run <cmd> in the wordpress container (e.g. wp-cli)
#   bin/stack seed [count] [due-now]    # seed <count> (default 50) pending probe actions
#   bin/stack reset [count] [due-now]   # clear transient/claims/leftovers, then re-seed
#   bin/stack preflight                 # assert preconditions, emit a JSON snapshot
#   bin/stack measure <control>         # run a CLI control, write a result record
#                                        #   <control>: wp-cron | action-scheduler
#   bin/stack measure-admin-page-load <scenario-label>
#                                        # authenticated wp-admin page load
#                                        # (issue #7), write a result record
#   bin/stack measure-manual-run <scenario-label>
#                                        # authenticated manual "Run" click from
#                                        # the Scheduled Actions admin screen
#                                        # (issue #7), write a result record
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$REPO_ROOT/docker-compose.yml"

# Hash the checkout path (not the branch, not the repo name) so every
# separate working copy on this machine gets its own namespace.
#
# The port is only 400-wide (8500-8899), so two checkouts can still collide
# probabilistically (~1-in-400 chance per pair) even though their hashes
# differ. `docker compose up` fails loudly on a bind conflict rather than
# silently sharing the port, so a collision is a re-run-`up`-after-noticing
# problem, not a silent one -- fine for a local PoC, worth widening the
# range or adding a bind-retry loop if this needs stronger guarantees.
HASH="$(printf '%s' "$REPO_ROOT" | shasum -a 256 | cut -c1-8)"
PORT=$(( 8500 + (16#$HASH % 400) ))

export COMPOSE_PROJECT_NAME="wpcas-${HASH}"
export STACK_PORT="$PORT"

compose() {
    docker compose -f "$COMPOSE_FILE" "$@"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
    up)
        compose up -d --build "$@"
        echo ""
        echo "WordPress is reachable at: http://localhost:${STACK_PORT}/"
        echo "(namespace: ${COMPOSE_PROJECT_NAME}, derived from ${REPO_ROOT})"
        ;;
    down)
        compose down "$@"
        ;;
    shell)
        compose exec wordpress bash "$@"
        ;;
    exec)
        # -T: no pseudo-tty, so this also works from non-interactive scripts.
        compose exec -T wordpress "$@"
        ;;
    seed)
        # -T: see `exec` above -- this also runs from non-interactive scripts.
        # --use-include: `wp eval-file` defaults to eval()'ing the file's
        # contents as a string, and `declare( strict_types=1 )` is rejected
        # unconditionally inside eval() ("must be the very first statement")
        # no matter where it appears. --use-include runs the file via a
        # normal PHP `include` instead, same as any other required file in
        # this codebase, so strict_types works like it does everywhere else.
        compose exec -T wordpress wp eval-file --use-include /opt/wpcas-tools/seed.php "$@" --allow-root
        ;;
    reset)
        compose exec -T wordpress wp eval-file --use-include /opt/wpcas-tools/reset.php "$@" --allow-root
        ;;
    preflight)
        compose exec -T wordpress wp eval-file --use-include /opt/wpcas-tools/preflight.php "$@" --allow-root
        ;;
    measure)
        # Runs one CLI control (issue #4) and writes its result record to
        # results/ on the host -- not just inside the container -- so it
        # survives `bin/stack down` and can be committed as evidence.
        #
        # measure.php sends everything *except* the final JSON record to
        # STDOUT/STDERR split on purpose (see its own docblock): the record
        # goes to STDOUT and nothing else does, progress/diagnostics go to
        # STDERR. That alone isn't enough to guarantee $outfile only ever
        # holds a real record, though -- redirecting straight to $outfile
        # would create/truncate it before measure.php even runs, so a
        # preflight abort (non-zero exit, nothing on STDOUT) would still
        # leave a 0-byte file behind that looks like a record at a glance.
        # Write to a temp file in the same directory instead (so the final
        # `mv` is a same-filesystem rename, not a copy) and only place it
        # at $outfile once the command has actually exited 0; on failure,
        # delete the temp file and propagate the exit code instead of
        # leaving anything behind.
        control="${1:?Usage: $(basename "$0") measure <wp-cron|action-scheduler>}"
        mkdir -p "$REPO_ROOT/results"
        outfile="$REPO_ROOT/results/$(date -u +%Y%m%dT%H%M%SZ)-${control}.json"
        tmpfile="$(mktemp "${outfile}.XXXXXX.tmp")"
        rc=0
        compose exec -T wordpress wp eval-file --use-include /opt/wpcas-tools/measure.php "$control" --allow-root > "$tmpfile" || rc=$?
        if [ "$rc" -eq 0 ]; then
            mv "$tmpfile" "$outfile"
            echo "" >&2
            echo "Result record written to ${outfile}" >&2
        else
            rm -f "$tmpfile"
            echo "" >&2
            echo "measure.php exited ${rc} -- no result record written (see the diagnostics above, e.g. a failed preflight)." >&2
            exit "$rc"
        fi
        ;;
    measure-admin-page-load)
        # Same file/temp-file/mv discipline as `measure` above, for issue
        # #7's authenticated-admin-page-load script instead of a CLI
        # control -- see that file's own docblock.
        scenario="${1:?Usage: $(basename "$0") measure-admin-page-load <scenario-label>}"
        mkdir -p "$REPO_ROOT/results"
        outfile="$REPO_ROOT/results/$(date -u +%Y%m%dT%H%M%SZ)-admin-page-load-${scenario}.json"
        tmpfile="$(mktemp "${outfile}.XXXXXX.tmp")"
        rc=0
        compose exec -T wordpress wp eval-file --use-include /opt/wpcas-tools/measure-admin-page-load.php "$scenario" --allow-root > "$tmpfile" || rc=$?
        if [ "$rc" -eq 0 ]; then
            mv "$tmpfile" "$outfile"
            echo "" >&2
            echo "Result record written to ${outfile}" >&2
        else
            rm -f "$tmpfile"
            echo "" >&2
            echo "measure-admin-page-load.php exited ${rc} -- no result record written (see the diagnostics above, e.g. a failed preflight or canary-writability self-test)." >&2
            exit "$rc"
        fi
        ;;
    measure-manual-run)
        # Same file/temp-file/mv discipline as `measure` above, for issue
        # #7's authenticated-manual-run script instead of a CLI control --
        # see that file's own docblock.
        scenario="${1:?Usage: $(basename "$0") measure-manual-run <scenario-label>}"
        mkdir -p "$REPO_ROOT/results"
        outfile="$REPO_ROOT/results/$(date -u +%Y%m%dT%H%M%SZ)-manual-run-${scenario}.json"
        tmpfile="$(mktemp "${outfile}.XXXXXX.tmp")"
        rc=0
        compose exec -T wordpress wp eval-file --use-include /opt/wpcas-tools/measure-manual-run.php "$scenario" --allow-root > "$tmpfile" || rc=$?
        if [ "$rc" -eq 0 ]; then
            mv "$tmpfile" "$outfile"
            echo "" >&2
            echo "Result record written to ${outfile}" >&2
        else
            rm -f "$tmpfile"
            echo "" >&2
            echo "measure-manual-run.php exited ${rc} -- no result record written (see the diagnostics above, e.g. a failed preflight or canary-writability self-test)." >&2
            exit "$rc"
        fi
        ;;
    *)
        echo "Usage: $(basename "$0") {up|down|shell|exec|seed|reset|preflight|measure|measure-admin-page-load|measure-manual-run} [args...]" >&2
        echo "  up                    build and start the stack" >&2
        echo "  down                  stop and remove the stack" >&2
        echo "  shell                 open a shell in the wordpress container" >&2
        echo "  exec <cmd>            run <cmd> in the wordpress container, e.g.:" >&2
        echo "                          bin/stack exec wp core is-installed" >&2
        echo "  seed [count] [due-now]  seed <count> (default 50) pending probe actions" >&2
        echo "  reset [count] [due-now] clear transient/claims/leftovers, then re-seed" >&2
        echo "  preflight             assert preconditions, emit a JSON snapshot" >&2
        echo "  measure <control>     run a CLI control, write a result record;" >&2
        echo "                          <control>: wp-cron | action-scheduler" >&2
        echo "  measure-admin-page-load <scenario-label>" >&2
        echo "                        authenticated wp-admin page load, write a result record" >&2
        echo "  measure-manual-run <scenario-label>" >&2
        echo "                        authenticated manual 'Run' click from the Scheduled" >&2
        echo "                        Actions admin screen, write a result record" >&2
        exit 1
        ;;
esac
