#!/usr/bin/env bash
#
# Lifecycle wrapper around docker compose for this PoC's WordPress +
# Action Scheduler stack.
#
# Namespacing: the project name and host port are derived from a hash of
# this checkout's absolute path, so two checkouts (e.g. two worktrees, or
# two clones) can run `bin/stack up` at the same time without colliding on
# container/network/volume names or on the published port.
#
# Usage:
#   bin/stack up               # build (if needed) and start, print the URL
#   bin/stack down [args...]   # stop and remove containers
#   bin/stack shell            # interactive shell in the wordpress container
#   bin/stack exec <cmd>       # run <cmd> in the wordpress container (e.g. wp-cli)
#   bin/stack seed [count] [due-now]    # seed <count> (default 50) pending probe actions
#   bin/stack reset [count] [due-now]   # clear transient/claims/leftovers, then re-seed
#   bin/stack preflight                 # assert preconditions, emit a JSON snapshot
#   bin/stack measure <control>         # run a CLI control, write a result record
#                                        #   <control>: wp-cron | action-scheduler
#   bin/stack measure-http <label>      # GET wp-cron.php, write a result record
#   bin/stack set-disable-wp-cron <true|false>
#                                        # flip the DISABLE_WP_CRON constant at
#                                        # runtime (issue #5) -- recreates the
#                                        # container with a new env value, no
#                                        # image rebuild
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$REPO_ROOT/docker-compose.yml"

# Hash the checkout path (not the branch, not the repo name) so every
# separate working copy on this machine gets its own namespace.
#
# The port is only 400-wide (8500-8899), so two checkouts can still collide
# probabilistically (~1-in-400 chance per pair) even though their hashes
# differ. `docker compose up` fails loudly on a bind conflict rather than
# silently sharing the port, so a collision is a re-run-`up`-after-noticing
# problem, not a silent one -- fine for a local PoC, worth widening the
# range or adding a bind-retry loop if this needs stronger guarantees.
HASH="$(printf '%s' "$REPO_ROOT" | shasum -a 256 | cut -c1-8)"
PORT=$(( 8500 + (16#$HASH % 400) ))

export COMPOSE_PROJECT_NAME="wpcas-${HASH}"
export STACK_PORT="$PORT"

# Issue #5: the DISABLE_WP_CRON constant (baked into the image as a fixed
# `true` since issue #2) must be switchable at runtime, without rebuilding
# the image -- the "fleet caveat" scenario needs to prove the guard goes
# inert with this false, and a rebuild-per-scenario would defeat the point
# of measuring the *same* image under different runtime conditions. Default
# true if the caller hasn't overridden it, so `bin/stack up` on its own
# reproduces the same DISABLE_WP_CRON=true behaviour issue #2 shipped.
export WPCAS_DISABLE_WP_CRON="${WPCAS_DISABLE_WP_CRON:-true}"

compose() {
    docker compose -f "$COMPOSE_FILE" "$@"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
    up)
        compose up -d --build "$@"
        echo ""
        echo "WordPress is reachable at: http://localhost:${STACK_PORT}/"
        echo "(namespace: ${COMPOSE_PROJECT_NAME}, derived from ${REPO_ROOT})"
        ;;
    down)
        compose down "$@"
        ;;
    shell)
        compose exec wordpress bash "$@"
        ;;
    exec)
        # -T: no pseudo-tty, so this also works from non-interactive scripts.
        compose exec -T wordpress "$@"
        ;;
    seed)
        # -T: see `exec` above -- this also runs from non-interactive scripts.
        # --use-include: `wp eval-file` defaults to eval()'ing the file's
        # contents as a string, and `declare( strict_types=1 )` is rejected
        # unconditionally inside eval() ("must be the very first statement")
        # no matter where it appears. --use-include runs the file via a
        # normal PHP `include` instead, same as any other required file in
        # this codebase, so strict_types works like it does everywhere else.
        compose exec -T wordpress wp eval-file --use-include /opt/wpcas-tools/seed.php "$@" --allow-root
        ;;
    reset)
        compose exec -T wordpress wp eval-file --use-include /opt/wpcas-tools/reset.php "$@" --allow-root
        ;;
    preflight)
        compose exec -T wordpress wp eval-file --use-include /opt/wpcas-tools/preflight.php "$@" --allow-root
        ;;
    measure|measure-http)
        # Runs one control -- a CLI control (issue #4, `measure`) or an
        # HTTP-vector request (issue #5, `measure-http`) -- and writes its
        # result record to results/ on the host -- not just inside the
        # container -- so it survives `bin/stack down` and can be
        # committed as evidence.
        #
        # Both measure.php and measure-http.php send everything *except*
        # the final JSON record to STDOUT/STDERR split on purpose (see
        # their own docblocks): the record goes to STDOUT and nothing else
        # does, progress/diagnostics go to STDERR. That alone isn't enough
        # to guarantee $outfile only ever holds a real record, though --
        # redirecting straight to $outfile would create/truncate it before
        # the script even runs, so a preflight abort (non-zero exit,
        # nothing on STDOUT) would still leave a 0-byte file behind that
        # looks like a record at a glance. Write to a temp file in the
        # same directory instead (so the final `mv` is a same-filesystem
        # rename, not a copy) and only place it at $outfile once the
        # command has actually exited 0; on failure, delete the temp file
        # and propagate the exit code instead of leaving anything behind.
        if [ "$cmd" = "measure" ]; then
            script="/opt/wpcas-tools/measure.php"
            usage_label="measure <wp-cron|action-scheduler>"
        else
            script="/opt/wpcas-tools/measure-http.php"
            usage_label="measure-http <label>"
        fi
        control="${1:?Usage: $(basename "$0") ${usage_label}}"
        mkdir -p "$REPO_ROOT/results"
        outfile="$REPO_ROOT/results/$(date -u +%Y%m%dT%H%M%SZ)-${control}.json"
        tmpfile="$(mktemp "${outfile}.XXXXXX.tmp")"
        rc=0
        compose exec -T wordpress wp eval-file --use-include "$script" "$control" --allow-root > "$tmpfile" || rc=$?
        if [ "$rc" -eq 0 ]; then
            mv "$tmpfile" "$outfile"
            echo "" >&2
            echo "Result record written to ${outfile}" >&2
        else
            rm -f "$tmpfile"
            echo "" >&2
            echo "$(basename "$script") exited ${rc} -- no result record written (see the diagnostics above, e.g. a failed preflight)." >&2
            exit "$rc"
        fi
        ;;
    set-disable-wp-cron)
        # Issue #5: flips the DISABLE_WP_CRON constant without rebuilding
        # the image. wp-config.php (docker/Dockerfile) reads this env var
        # via getenv() on every request, so recreating the container with
        # a new value is enough -- `compose up -d` here deliberately omits
        # `--build` (unlike the `up` case above): only the container is
        # recreated, the image is untouched.
        value="${1:?Usage: $(basename "$0") set-disable-wp-cron <true|false>}"
        case "$value" in
            true|false) ;;
            *)
                echo "error: value must be 'true' or 'false', got '${value}'" >&2
                exit 1
                ;;
        esac
        WPCAS_DISABLE_WP_CRON="$value" compose up -d wordpress
        echo "DISABLE_WP_CRON is now ${value} (container recreated, image not rebuilt)." >&2
        ;;
    *)
        echo "Usage: $(basename "$0") {up|down|shell|exec|seed|reset|preflight|measure|measure-http|set-disable-wp-cron} [args...]" >&2
        echo "  up                    build and start the stack" >&2
        echo "  down                  stop and remove the stack" >&2
        echo "  shell                 open a shell in the wordpress container" >&2
        echo "  exec <cmd>            run <cmd> in the wordpress container, e.g.:" >&2
        echo "                          bin/stack exec wp core is-installed" >&2
        echo "  seed [count] [due-now]  seed <count> (default 50) pending probe actions" >&2
        echo "  reset [count] [due-now] clear transient/claims/leftovers, then re-seed" >&2
        echo "  preflight             assert preconditions, emit a JSON snapshot" >&2
        echo "  measure <control>     run a CLI control, write a result record;" >&2
        echo "                          <control>: wp-cron | action-scheduler" >&2
        echo "  measure-http <label>  GET wp-cron.php unauthenticated, write a result record" >&2
        echo "  set-disable-wp-cron <true|false>" >&2
        echo "                        flip DISABLE_WP_CRON at runtime, no rebuild" >&2
        exit 1
        ;;
esac
