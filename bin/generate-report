#!/usr/bin/env php
<?php

declare( strict_types=1 );

/**
 * Issue #10: renders one bin/measure-matrix run's committed records into a
 * single, committed Markdown results document.
 *
 * Deliberately reads ONLY from results/matrix/<run-timestamp>/ -- never
 * the top-level results/ directory, which holds the individual example
 * records #5/#6/#7 committed directly on their own branches. Conflating
 * those with a fresh matrix run's own output would let a stale, cherry-
 * picked example stand in for a real, reproduced figure -- exactly what
 * this ticket's measurement-integrity requirement rules out. See this
 * repo's issue #10 PR, `## Decisions`, for that convention.
 *
 * Every figure in the rendered report traces back to a field read
 * directly from one of these committed JSON records -- nothing here
 * computes, rounds, or estimates a figure that isn't already present
 * verbatim in a record. A scenario that produced a negative result (see
 * bin/measure-matrix's own record_negative()) is rendered in the
 * "Not verified" section, explicitly, never silently folded into the
 * scenario table as if it had succeeded.
 *
 * Usage:
 *   bin/generate-report [run-directory] [output-file]
 *     run-directory  defaults to the most recently modified directory
 *                    under results/matrix/
 *     output-file    defaults to docs/measurements/full-scenario-matrix-report.md
 */

$repo_root = dirname( __DIR__ );

$run_dir = $argv[1] ?? null;
if ( null === $run_dir ) {
	$matrix_root = $repo_root . '/results/matrix';
	$candidates  = glob( $matrix_root . '/*', GLOB_ONLYDIR );
	if ( false === $candidates || array() === $candidates ) {
		fwrite( STDERR, "generate-report: no run directories found under {$matrix_root}. Run bin/measure-matrix first.\n" );
		exit( 1 );
	}
	// Sorted by basename, NOT filemtime: bin/measure-matrix names every run
	// directory after the UTC timestamp it started (e.g. 20260729T174806Z,
	// produced by `date -u +%Y%m%dT%H%M%SZ`), which is ISO-8601-shaped --
	// lexicographic order on that string is exactly chronological order.
	// filemtime() looked right locally but silently breaks after a fresh
	// git clone: git sets every checked-out file's mtime to checkout time,
	// so a repo with two committed runs would have both directories'
	// mtimes collapse to (effectively) the same instant, making "newest by
	// filemtime" non-deterministic -- exactly the kind of unverifiable
	// selection this evidence pipeline exists to rule out. An explicit
	// run-directory argument (below) always overrides this default.
	rsort( $candidates );
	$run_dir = $candidates[0];
}
$run_dir = rtrim( (string) $run_dir, '/' );

if ( ! is_dir( $run_dir ) ) {
	fwrite( STDERR, "generate-report: run directory '{$run_dir}' does not exist.\n" );
	exit( 1 );
}

$output_file = $argv[2] ?? ( $repo_root . '/docs/measurements/full-scenario-matrix-report.md' );

$run_timestamp = basename( $run_dir );

// --- Load and classify every record in the run directory --------------------

$files = glob( $run_dir . '/*.json' );
if ( false === $files ) {
	$files = array();
}
sort( $files );

$scenarios     = array(); // ordinary measured scenario records (have 'outcome')
$negatives     = array(); // result_kind === 'negative'
$occupancy     = null;    // the occupancy-drain record, if present
$unhook_timing = null;    // the unhook-timing record, if present
$unparseable   = array();

foreach ( $files as $file ) {
	$raw     = file_get_contents( $file );
	$decoded = is_string( $raw ) ? json_decode( $raw, true ) : null;

	if ( ! is_array( $decoded ) ) {
		$unparseable[] = basename( $file );
		continue;
	}

	if ( ( $decoded['result_kind'] ?? null ) === 'negative' ) {
		$decoded['_file'] = basename( $file );
		$negatives[]      = $decoded;
		continue;
	}

	if ( ( $decoded['measurement_kind'] ?? null ) === 'unhook-timing' ) {
		$unhook_timing = $decoded;
		continue;
	}

	if ( array_key_exists( 'workers_total', $decoded ) && array_key_exists( 'trigger', $decoded ) ) {
		$occupancy = $decoded;
		if ( ( $decoded['result_kind'] ?? 'measured' ) !== 'measured' ) {
			// Occupancy's own build function already reports negative/
			// partial results honestly in-band (see occupancy-assertions.php)
			// -- surfaced in "Not verified" too so it isn't missed if a
			// reader skips straight to the occupancy section.
			$decoded['_file']  = basename( $file );
			$decoded['reason'] = 'occupancy result_kind=' . ( $decoded['result_kind'] ?? 'unknown' ) . ' -- see notes';
			$negatives[]       = $decoded;
		}
		continue;
	}

	if ( array_key_exists( 'outcome', $decoded ) ) {
		$decoded['_file'] = basename( $file );
		$scenarios[]      = $decoded;
		continue;
	}

	$unparseable[] = basename( $file );
}

// --- Rendering helpers --------------------------------------------------

/**
 * @param array<int, int> $sections
 */
function wpcas_report_armed_label( array $sections ): string {
	if ( array() === $sections ) {
		return 'none (fully disarmed)';
	}
	sort( $sections );
	return implode( ', ', array_map( static fn( int $n ): string => (string) $n, $sections ) );
}

/**
 * One of `server_observed`'s statuses, rendered for the scenario table
 * (issue #35).
 *
 * Three outcomes, kept distinct on purpose:
 *
 *   - `n/a`  -- the record carries no `server_observed` at all, so this
 *               source does not apply to the row (a CLI control never made
 *               an HTTP request to correlate).
 *   - `none` -- the block exists but this source recorded nothing for the
 *               request. Never rendered as a number borrowed from another
 *               source: for a section-5 row, FPM and the post-flush probe
 *               recording nothing IS the evidence that nginx refused the
 *               request before PHP ran.
 *   - the status itself.
 *
 * @param array<string, mixed>|null $server_observed
 */
function wpcas_report_server_status( ?array $server_observed, string $key ): string {
	if ( null === $server_observed ) {
		return 'n/a';
	}

	$status = $server_observed[ $key ] ?? null;

	return null === $status ? 'none' : (string) (int) $status;
}

/**
 * @param array<string, mixed>|null $preflight
 */
function wpcas_report_preflight_compact( ?array $preflight ): string {
	if ( null === $preflight ) {
		return '(not captured)';
	}

	return sprintf(
		'ok=%s pending=%d callback=%s cron_in_progress=%s claims=%d',
		( $preflight['ok'] ?? false ) ? 'true' : 'false',
		(int) ( $preflight['pending_count'] ?? -1 ),
		( $preflight['callback_attached'] ?? false ) ? 'true' : 'false',
		( $preflight['cron_in_progress'] ?? false ) ? 'true' : 'false',
		(int) ( $preflight['claims_count'] ?? -1 )
	);
}

/**
 * @param array<string, mixed> $contexts
 */
function wpcas_report_contexts_compact( array $contexts ): string {
	$started = $contexts['started'] ?? array();
	if ( array() === $started ) {
		return '(none)';
	}
	$parts = array();
	foreach ( $started as $context => $count ) {
		$parts[] = sprintf( '%s=%d', $context, $count );
	}
	return implode( '; ', $parts );
}

/**
 * @param array<string, mixed> $contexts
 */
function wpcas_report_contexts_full( array $contexts ): string {
	$lines = array();
	foreach ( array( 'started', 'completed', 'other' ) as $bucket ) {
		$entries = $contexts[ $bucket ] ?? array();
		if ( array() === $entries ) {
			$lines[] = "  - {$bucket}: (none)";
			continue;
		}
		$parts = array();
		foreach ( $entries as $key => $count ) {
			$parts[] = sprintf( '%s=%d', $key, $count );
		}
		$lines[] = "  - {$bucket}: " . implode( ', ', $parts );
	}
	return implode( "\n", $lines );
}

function wpcas_report_md_escape( string $value ): string {
	return str_replace( '|', '\\|', $value );
}

// --- Build the document ---------------------------------------------------

$md   = array();
$md[] = '# Full scenario matrix report';
$md[] = '';
$md[] = 'Generated by `bin/generate-report` from committed records in `results/matrix/' . $run_timestamp . '/` -- run `bin/measure-matrix` then `bin/generate-report` to reproduce every figure below from a fresh run.';
$md[] = '';
$md[] = sprintf(
	'Source run: `%s` -- %d scenario record(s), %d negative result(s)%s.',
	$run_timestamp,
	count( $scenarios ),
	count( $negatives ),
	( null !== $occupancy ? ', 1 occupancy measurement' : '' ) . ( null !== $unhook_timing ? ', 1 unhook-timing measurement' : '' )
);
$md[] = '';

// --- Scenario table ---------------------------------------------------

$md[] = '## Scenario table';
$md[] = '';
$md[] = 'Every row below is read directly from its own committed record under `results/matrix/' . $run_timestamp . '/<scenario>.json` -- the `Preflight` column is that exact run\'s preflight snapshot (captured *before* the control ran), so a reader can verify the empty-queue, missing-callback, stale-claim, and leftover-transient traps were excluded for that specific row, not take it on trust.';
$md[] = '';
$md[] = 'The four status columns are four independent sources for the same request, and they are allowed to disagree -- that disagreement is the masking finding (issue #35), not an inconsistency. `Client` is what this repo\'s own HTTP client read off the wire (`http_status`); `nginx` and `FPM` are what each server independently logged for that request id (`server_observed.web_status` / `.fpm_status`); `Post-flush` is PHP\'s own status read back at shutdown, after the response was already closed (`server_observed.post_flush_status`). A `n/a` means that source does not apply to the row (a CLI control never made a request); a `none` means the source applies but recorded nothing -- for `FPM`/`Post-flush` on a section-5 row, that is the point: the request never reached PHP at all. **No column here decides an outcome**; outcome is always the pending-count delta plus the probe\'s own execution log.';
$md[] = '';
$md[] = '| Scenario | Armed sections | DISABLE_WP_CRON | Drained | Fully drained | Execution contexts (started) | Elapsed (s) | Client | nginx | FPM | Post-flush | Preflight snapshot |';
$md[] = '|---|---|---|---|---|---|---|---|---|---|---|---|';

foreach ( $scenarios as $scenario ) {
	$context       = $scenario['matrix_context'] ?? array();
	$armed         = wpcas_report_armed_label( $context['armed_sections'] ?? array() );
	$disable_cron  = array_key_exists( 'disable_wp_cron', $context ) ? ( $context['disable_wp_cron'] ? 'true' : 'false' ) : 'n/a';
	$outcome       = $scenario['outcome'] ?? array();
	$contexts_desc = wpcas_report_contexts_compact( $scenario['execution_contexts'] ?? array() );
	$elapsed       = array_key_exists( 'elapsed_seconds', $scenario ) ? sprintf( '%.3f', (float) $scenario['elapsed_seconds'] ) : 'n/a';
	$http_status   = null === ( $scenario['http_status'] ?? null ) ? 'n/a' : (string) $scenario['http_status'];
	$preflight     = wpcas_report_preflight_compact( $scenario['preflight'] ?? null );

	// Issue #35: the three server-side statuses, each rendered from its own
	// field and never backfilled from another. `server_observed` absent
	// entirely (a CLI control) reads "n/a"; present but null for one source
	// reads "none" -- a real observation about where a request stopped, not
	// a missing figure. wpcas_report_server_status() keeps that distinction
	// in one place rather than three inline ternaries.
	$server_observed = $scenario['server_observed'] ?? null;

	$md[] = sprintf(
		'| `%s` | %s | %s | %d | %s | %s | %s | %s | %s | %s | %s | %s |',
		wpcas_report_md_escape( (string) ( $scenario['control'] ?? $scenario['_file'] ) ),
		wpcas_report_md_escape( $armed ),
		$disable_cron,
		(int) ( $outcome['drained'] ?? 0 ),
		( $outcome['fully_drained'] ?? false ) ? 'true' : 'false',
		wpcas_report_md_escape( $contexts_desc ),
		$elapsed,
		$http_status,
		wpcas_report_server_status( $server_observed, 'web_status' ),
		wpcas_report_server_status( $server_observed, 'fpm_status' ),
		wpcas_report_server_status( $server_observed, 'post_flush_status' ),
		wpcas_report_md_escape( $preflight )
	);
}
$md[] = '';

// --- The masking finding (issue #35) -------------------------------------
//
// Rendered as its own section because it is the finding this repo exists
// for, and because it is only legible as a COMPARISON: the same guard
// decision, at two layers, producing two different things a client can see.
// Every figure below is read verbatim from a field of a committed record in
// this run -- the prose says what the numbers mean, it never supplies one.

$md[] = '## The masking finding: a guard inside PHP cannot return a status (issue #35)';
$md[] = '';

$masking_rows = array(
	'http-cron-armed'  => 'Guard section 1 -- the block runs INSIDE WordPress, as a mu-plugin, after core\'s `wp-cron.php` has already called `fastcgi_finish_request()`.',
	'nginx-cron-armed' => 'Guard section 5 -- the same block, moved in FRONT of PHP (nginx). Nothing has been flushed, because PHP never ran.',
);

$masking_found = false;
foreach ( $masking_rows as $control => $description ) {
	$record = null;
	foreach ( $scenarios as $scenario ) {
		if ( $control === ( $scenario['control'] ?? null ) ) {
			$record = $scenario;
			break;
		}
	}

	if ( null === $record ) {
		continue;
	}

	$masking_found   = true;
	$server_observed = $record['server_observed'] ?? null;
	$outcome         = $record['outcome'] ?? array();

	$md[] = sprintf( '### `%s`', $control );
	$md[] = '';
	$md[] = $description;
	$md[] = '';
	$md[] = sprintf( '- Status the client read: **%s**', null === ( $record['http_status'] ?? null ) ? 'n/a' : (string) $record['http_status'] );
	$md[] = sprintf( '- Status nginx logged: **%s**', wpcas_report_server_status( $server_observed, 'web_status' ) );
	$md[] = sprintf( '- Status PHP-FPM logged: **%s**', wpcas_report_server_status( $server_observed, 'fpm_status' ) );
	$md[] = sprintf( '- Status PHP held at shutdown, after the response was closed: **%s**', wpcas_report_server_status( $server_observed, 'post_flush_status' ) );
	$md[] = sprintf( '- Probe actions drained: **%d** of %d', (int) ( $outcome['drained'] ?? 0 ), (int) ( $outcome['pending_before'] ?? 0 ) );
	$md[] = '';
}

if ( $masking_found ) {
	$md[] = 'What the two rows above establish together, and what each on its own cannot:';
	$md[] = '';
	$md[] = '1. **The guard works either way.** Both rows drained zero. Outcome never came from a status.';
	$md[] = '2. **Only the outer layer can say so.** Section 1\'s client reads a success; section 5\'s client reads the refusal.';
	$md[] = '3. **The masked 403 is not hidden somewhere server-side -- it does not exist.** This is the claim issue #35 required be verified rather than assumed, and the verification is the two "status" lines under `http-cron-armed`: PHP-FPM logged the flushed status, and PHP\'s own status at shutdown was still the flushed status. A guard\'s `http_response_code( 403 )` after `fastcgi_finish_request()` is refused outright -- measured directly, and independently of WordPress, by the isolation proof (`bin/stack measure-fastcgi-isolation`, committed under `results/`): its `flush-then-status` file records `attempted_status` 403, `set_call_returned` false, and a post-flush status read back as 200, while its `status-then-flush` control -- same call, nothing flushed first -- records 403 accepted and observable.';
	$md[] = '';
	$md[] = 'The cost of that visibility is the next section\'s counter-example: nginx cannot read `DISABLE_WP_CRON`, so section 5 blocks a site that still depends on the web loopback.';
	$md[] = '';
} else {
	$md[] = '_Neither `http-cron-armed` nor `nginx-cron-armed` produced a record in this run -- nothing to compare. See the "Not verified" section below._';
	$md[] = '';
}

// --- The fleet caveat, and the layer that cannot honour it (issue #36) ----
//
// ADR-0003's trade-off, rendered from the two cron-constant-off records
// rather than argued. Same vector, same constant, two layers: one goes
// inert (by design), the other cannot.

$md[] = '## The fleet caveat: what an nginx-layer block cannot do (issue #36)';
$md[] = '';
$md[] = 'Both rows below run with `DISABLE_WP_CRON` **false** -- a site that has not opted out of core\'s own loopback, and therefore still depends on `wp-cron.php` being reachable for cron to run at all.';
$md[] = '';

$fleet_rows = array(
	'http-cron-armed-cron-enabled'  => 'Guard section 1 (inside WordPress) checks the constant and deliberately goes inert.',
	'nginx-cron-armed-cron-enabled' => 'Guard section 5 (nginx) cannot read a PHP constant, so it blocks regardless.',
);

$fleet_found = false;
foreach ( $fleet_rows as $control => $description ) {
	$record = null;
	foreach ( $scenarios as $scenario ) {
		if ( $control === ( $scenario['control'] ?? null ) ) {
			$record = $scenario;
			break;
		}
	}

	if ( null === $record ) {
		continue;
	}

	$fleet_found = true;
	$outcome     = $record['outcome'] ?? array();

	$md[] = sprintf(
		'- `%s` -- %s Status the client read: **%s**. Drained: **%d** of %d.',
		$control,
		$description,
		null === ( $record['http_status'] ?? null ) ? 'n/a' : (string) $record['http_status'],
		(int) ( $outcome['drained'] ?? 0 ),
		(int) ( $outcome['pending_before'] ?? 0 )
	);
}
$md[] = '';

if ( $fleet_found ) {
	$md[] = 'This is the committed counter-example, not a caveat in prose: an **observable status** or a fleet-safe conditional block, at one layer, but not both. A shared guard rolled out across a fleet arms section 5 for every site alike -- including the ones whose cron it silently ends.';
	$md[] = '';
}

// --- Per-entry-point execution contexts (full) ---------------------------

$md[] = '## Execution contexts by entry point';
$md[] = '';
$md[] = 'Full started/completed/other breakdown per scenario, straight from each record\'s own `execution_contexts` field (see `docker/wp-cli/lib/result-record.php`) -- the scenario table above shows only the `started` counts for scanability.';
$md[] = '';
foreach ( $scenarios as $scenario ) {
	$md[] = sprintf( '- `%s`:', $scenario['control'] ?? $scenario['_file'] );
	$md[] = wpcas_report_contexts_full( $scenario['execution_contexts'] ?? array() );
}
$md[] = '';

// --- Unhook timing table (issue #8) --------------------------------------

$md[] = '## Unhook timing table (issue #8)';
$md[] = '';
if ( null !== $unhook_timing && 'measured' === ( $unhook_timing['result_kind'] ?? null ) ) {
	$md[] = sprintf( 'Action Scheduler version measured (this run): **%s**.', $unhook_timing['action_scheduler_version'] ?? 'unknown' );
	$md[] = '';
	// This table is a deliberate composite, not a single request's output --
	// see bin/measure-unhook-timing's own docblock. Every row except
	// `init:101` comes from request 1 (guard fully disarmed); `init:101`
	// comes from request 2 (section 4 armed) instead, because that row is
	// specifically about what the guard removes. Called out here, right
	// above the table, because the raw JSON blocks printed below it show
	// request 1's own `init:101` as "attached, priority 10" -- an
	// apparent contradiction unless a reader already knows which row came
	// from which request.
	$md[] = '_Composite table: every row is from request 1 (guard disarmed) except `init:101`, which is from request 2 (section 4 armed) -- the one row this measurement needs the guard armed to observe. See the raw JSON for both requests below; request 1\'s own `init:101` reads "attached" there because the guard was not armed for that request._';
	$md[] = '';
	$md[] = trim( (string) ( $unhook_timing['table_markdown'] ?? '(table not captured)' ) );
	$md[] = '';
	$md[] = 'Raw JSON, request 1 (guard disarmed):';
	$md[] = '';
	$md[] = '```json';
	$md[] = (string) json_encode( $unhook_timing['request_1_guard_disarmed'] ?? null, JSON_PRETTY_PRINT );
	$md[] = '```';
	$md[] = '';
	$md[] = 'Raw JSON, request 2 (section 4 armed):';
	$md[] = '';
	$md[] = '```json';
	$md[] = (string) json_encode( $unhook_timing['request_2_section_4_armed'] ?? null, JSON_PRETTY_PRINT );
	$md[] = '```';
} else {
	$md[] = 'NOT AVAILABLE for this run -- see `## Not verified` below.';
}
$md[] = '';

// --- Worker occupancy (issue #9) ------------------------------------------

$md[] = '## Worker occupancy during a drain (issue #9)';
$md[] = '';
if ( null !== $occupancy ) {
	$trigger = $occupancy['trigger'] ?? array();
	$md[]    = sprintf( '- Result kind: `%s`', $occupancy['result_kind'] ?? 'unknown' );
	$md[]    = sprintf( '- Server model: %s', $occupancy['server_model'] ?? 'unknown' );
	$md[]    = sprintf( '- Workers total: %d', (int) ( $occupancy['workers_total'] ?? 0 ) );
	$md[]    = sprintf(
		'- Workers occupied by drain: %d (%s)',
		(int) ( $occupancy['workers_occupied_by_drain'] ?? 0 ),
		$occupancy['workers_occupied_by_drain_method'] ?? 'unknown method'
	);
	$md[] = sprintf(
		'- Trigger request: %s, %.3fs, is_fast=%s',
		(string) ( $trigger['http_code'] ?? 'n/a' ),
		(float) ( $trigger['response_seconds'] ?? 0.0 ),
		( $trigger['is_fast'] ?? false ) ? 'true' : 'false'
	);
	$md[] = sprintf(
		'- Drain duration: %s -- completed=%s, observed in flight=%s',
		null === ( $occupancy['drain_duration_seconds'] ?? null ) ? 'n/a' : sprintf( '%.3fs', (float) $occupancy['drain_duration_seconds'] ),
		( $occupancy['drain_completed'] ?? false ) ? 'true' : 'false',
		( $occupancy['drain_observed_in_flight'] ?? false ) ? 'true' : 'false'
	);
	$md[] = sprintf( '- Degradation observed (>25%% at highest tested concurrency): %s', ( $occupancy['degradation_observed'] ?? false ) ? 'true' : 'false' );
	$md[] = '';
	$md[] = '| Concurrency | Baseline avg (s) | During-drain avg (s) | Delta (s) | Delta (%) |';
	$md[] = '|---|---|---|---|---|';
	foreach ( (array) ( $occupancy['degradation_by_concurrency'] ?? array() ) as $concurrency => $row ) {
		$md[] = sprintf(
			'| %s | %.4f | %.4f | %.4f | %s |',
			(string) $concurrency,
			(float) ( $row['baseline_avg_seconds'] ?? 0.0 ),
			(float) ( $row['during_drain_avg_seconds'] ?? 0.0 ),
			(float) ( $row['delta_seconds'] ?? 0.0 ),
			null === ( $row['delta_pct'] ?? null ) ? 'n/a' : sprintf( '%.1f%%', 100 * (float) $row['delta_pct'] )
		);
	}
	if ( array() !== (array) ( $occupancy['notes'] ?? array() ) ) {
		$md[] = '';
		$md[] = 'Notes (from the record itself):';
		foreach ( (array) $occupancy['notes'] as $note ) {
			$md[] = '- ' . $note;
		}
	}
} else {
	$md[] = 'NOT AVAILABLE for this run -- see `## Not verified` below.';
}
$md[] = '';

// --- Not verified ----------------------------------------------------------

$md[] = '## Not verified';
$md[] = '';
if ( array() === $negatives && array() === $unparseable ) {
	$md[] = 'Every scenario in this run reproduced and emitted a positive result record. Nothing to report here.';
} else {
	foreach ( $negatives as $negative ) {
		$md[] = sprintf( '### `%s`', $negative['control'] ?? $negative['_file'] ?? 'unknown' );
		$md[] = '';
		$md[] = sprintf( '- Reason: `%s`', $negative['reason'] ?? 'unknown' );
		if ( array_key_exists( 'exit_code', $negative ) ) {
			$md[] = sprintf( '- Exit code: %d', (int) $negative['exit_code'] );
		}
		if ( array_key_exists( 'matrix_context', $negative ) ) {
			$armed = wpcas_report_armed_label( $negative['matrix_context']['armed_sections'] ?? array() );
			$md[]  = sprintf( '- Armed sections: %s', $armed );
		}
		if ( null !== ( $negative['preflight'] ?? null ) ) {
			$md[] = sprintf( '- Preflight snapshot: %s', wpcas_report_preflight_compact( $negative['preflight'] ) );
		}
		if ( array_key_exists( 'notes', $negative ) ) {
			foreach ( (array) $negative['notes'] as $note ) {
				$md[] = '- Note: ' . $note;
			}
		}
		$md[] = sprintf( '- Full record: `results/matrix/%s/%s`', $run_timestamp, $negative['_file'] ?? '(unknown)' );
		$md[] = '';
	}
	foreach ( $unparseable as $file ) {
		$md[] = sprintf( '- `%s`: file present but not parseable as JSON -- see `results/matrix/%s/%s` directly.', $file, $run_timestamp, $file );
	}
}
$md[] = '';

$content = implode( "\n", $md );

$output_dir = dirname( $output_file );
if ( ! is_dir( $output_dir ) && ! mkdir( $output_dir, 0777, true ) && ! is_dir( $output_dir ) ) {
	fwrite( STDERR, "generate-report: could not create output directory '{$output_dir}'.\n" );
	exit( 1 );
}

file_put_contents( $output_file, $content );

fwrite( STDERR, "Report written to {$output_file} (source run: {$run_dir}).\n" );
echo $output_file, "\n";
