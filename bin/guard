#!/usr/bin/env bash
#
# Arm/disarm the cron-runner-policy guard sections.
#
# Each section has an artefact -- a file in an -available/ directory -- and
# a destination directory it gets copied into when armed. "Arming" a
# section copies its artefact from its -available/ directory into its
# destination; "disarming" it removes that copy. There is no flag or
# constant inside any guard artefact that changes its behaviour -- presence
# in its destination is the only toggle, so whatever runs during a scenario
# is exactly the code that would ship.
#
# Sections 1-4 act inside WordPress: their artefacts are mu-plugins in
# docker/mu-plugins-available/, and their destination is
# docker/mu-plugins/, which docker-compose.yml bind-mounts onto
# wp-content/mu-plugins in the php-fpm container and WordPress never scans
# otherwise.
#
# Section 5 (issue #36 / ADR-0003) acts in FRONT of WordPress, in nginx,
# so both halves of that pair differ: its artefact is a marker file in
# docker/nginx-guards-available/, and its destination is
# docker/nginx-guards/, bind-mounted into the nginx container. That is why
# the registry below carries a source directory per section as well as a
# destination -- neither half is hard-coded, and nothing in this script
# assumes a section is a mu-plugin.
#
# Arming takes effect on the next request either way, with no rebuild,
# reload or restart: WordPress re-scans wp-content/mu-plugins/ on every
# request, and nginx re-tests for section 5's marker on every request (see
# docker/nginx/default.conf's `location = /wp/wp-cron.php`). One arming
# concept, one off state, two layers.
#
# Usage:
#   bin/guard arm [section...]   # activate exactly these sections (1-5);
#                                 # no arguments disarms everything
#   bin/guard status             # report which sections are armed, without
#                                 # changing anything
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AVAILABLE_DIR="$REPO_ROOT/docker/mu-plugins-available"
ENABLED_DIR="$REPO_ROOT/docker/mu-plugins"
NGINX_AVAILABLE_DIR="$REPO_ROOT/docker/nginx-guards-available"
NGINX_ENABLED_DIR="$REPO_ROOT/docker/nginx-guards"

# The guard section registry: number, artefact filename, source directory,
# destination directory, and label -- in one place, in report order. This is
# the only place that maps a ticket's "section N" language onto a file,
# where that file comes from, where arming it lands, and what it does.
# Every loop below is driven by this list rather than a literal "1 2 3 4 5".
GUARD_SECTIONS=(
    "1|10-block-http-cron.php|$AVAILABLE_DIR|$ENABLED_DIR|block HTTP requests to the cron entry point"
    "2|20-suppress-async-dispatch.php|$AVAILABLE_DIR|$ENABLED_DIR|suppress Action Scheduler's async dispatch"
    "3|30-log-non-cli-canary.php|$AVAILABLE_DIR|$ENABLED_DIR|log a canary on any non-CLI queue run"
    "4|40-unhook-queue-runner.php|$AVAILABLE_DIR|$ENABLED_DIR|unhook the queue runner outside WP-CLI"
    "5|50-block-cron-entry-point.marker|$NGINX_AVAILABLE_DIR|$NGINX_ENABLED_DIR|block the cron entry point in front of PHP (nginx)"
)

# Looks up one field (file, source, dest or label) of one section's registry
# entry. Returns non-zero if the section number isn't registered.
registry_field() {
    local wanted="$1" field="$2" entry num file source dest label
    for entry in "${GUARD_SECTIONS[@]}"; do
        IFS='|' read -r num file source dest label <<< "$entry"
        if [ "$num" = "$wanted" ]; then
            case "$field" in
                file) echo "$file" ;;
                source) echo "$source" ;;
                dest) echo "$dest" ;;
                label) echo "$label" ;;
            esac
            return 0
        fi
    done
    return 1
}

section_file() { registry_field "$1" file; }
section_source() { registry_field "$1" source; }
section_destination() { registry_field "$1" dest; }
section_label() { registry_field "$1" label; }

# All registered section numbers, in registry order.
all_sections() {
    local entry
    for entry in "${GUARD_SECTIONS[@]}"; do
        echo "${entry%%|*}"
    done
}

report_state() {
    echo "guard state:"
    for n in $(all_sections); do
        file="$(section_file "$n")"
        dest="$(section_destination "$n")"
        if [ -f "$dest/$file" ]; then
            state="armed"
        else
            state="disarmed"
        fi
        printf '  %d) %-8s %-45s [%s]\n' "$n" "$state" "$(section_label "$n")" "$file"
    done
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
    arm)
        valid_sections="$(all_sections | tr '\n' ' ')"
        valid_sections="${valid_sections% }"

        for requested in "$@"; do
            if ! section_file "$requested" >/dev/null 2>&1; then
                echo "error: unknown section '$requested' (valid: $valid_sections)" >&2
                exit 1
            fi
        done

        for n in $(all_sections); do
            file="$(section_file "$n")"
            source="$(section_source "$n")"
            dest="$(section_destination "$n")"
            want=0
            for requested in "$@"; do
                [ "$requested" = "$n" ] && want=1
            done

            mkdir -p "$dest"

            if [ "$want" = "1" ]; then
                cp "$source/$file" "$dest/$file"
            else
                rm -f "$dest/$file"
            fi
        done

        report_state
        ;;
    status)
        report_state
        ;;
    *)
        echo "Usage: $(basename "$0") {arm|status} [section...]" >&2
        echo "  arm [1 2 3 4 5] activate exactly these sections; no args disarms all" >&2
        echo "  status          report the current armed/disarmed state" >&2
        exit 1
        ;;
esac
