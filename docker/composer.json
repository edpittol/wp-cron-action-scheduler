{
    "name": "wpcas/webroot",
    "type": "project",
    "license": "MIT",
    "description": "Composer-provisioned webroot for the wp-cron-action-scheduler PoC -- WordPress core under /wp, Action Scheduler and the SQLite integration plugin in wp-content/plugins, pinned via this lockfile (see docs/adr/0001).",
    "repositories": [
        { "type": "composer", "url": "https://wpackagist.org" }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.3",
        "johnpbloch/wordpress-core-installer": "^2.0",
        "johnpbloch/wordpress-core": "7.0.2",
        "wpackagist-plugin/action-scheduler": "4.0.0",
        "wpackagist-plugin/sqlite-database-integration": "*"
    },
    "extra": {
        "wordpress-install-dir": "wp",
        "installer-paths": {
            "wp/wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
            "wp/wp-content/mu-plugins/{$name}/": ["type:wordpress-muplugin"]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "johnpbloch/wordpress-core-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
